model MyModel = {
  stringfield: string,
  stringarrayfield: [ string ],
  mapfield: map[string]string,
  name: string(name='realName'),
  submodel: {
    stringfield: string,
  },
  object: object,
  numberfield: integer,
  readable: readable,
  request: $Request,
  m: $Model,
  mapModel: map[string]lowerModel,
  submodelMap: map[string]MyModel.submodel
};

model lowerModel = {
  stringfield: string
};

model multiLayerModel = {
  data?: {
    results?: [ 
      {
        textRectangles?: {
          top?: int32(name='Top'),
          width?: int32(name='Width'),
          height?: int32(name='Height'),
          angle?: int32(name='Angle'),
          left?: int32(name='Left'),
        }(name='TextRectangles'),
        text?: string(name='Text'),
        probability?: float(name='Probability'),
      }
    ](name='Results'),
  }(name='Data'),
}

model Parent = {
  name: string,
  details: {
    value: string
  }
};

model Extend extends Parent = {
  size: integer
};

model Mapping = {
  nestedLists: [[[lowerModel]]],
  listMaps: [map[string]lowerModel],
  mapLists: map[string][lowerModel],
  nestedMaps: map[string]map[string]lowerModel,
  mapListMaps: map[string][map[string][lowerModel]],
  listMapLists: [map[string][[lowerModel]]],
  numbers: [integer],
  booleans: map[string]boolean,
  bytes: bytes,
  int8Value: int8,
  uint8Value: uint8,
  int16Value: int16,
  uint16Value: uint16,
  int32Value: int32,
  uint32Value: uint32,
  int64Value: int64,
  uint64Value: uint64,
  floatValue: float,
  doubleValue: double,
};

static function convertModel(value: map[string]any): MyModel {
  return value;
}

model Tree = {
  name: string,
  children: [Tree],
  branches: map[string]Tree,
  next: Tree,
};

model InlineLists = {
  values: [[{
    name: string,
    children: [Tree]
  }]]
};

model Left = {
  right: Right
};

model Right = {
  left: Left
};

model BuiltinChild extends $SSEEvent = {
  name: string
};

model RequestChild extends $Request = {
  count: integer
};
